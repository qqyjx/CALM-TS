# Large dataset artifacts — too big for GitHub, see DATA.md for reproduction.
# Hashes recorded in results/physionet_artifacts.sha256.
windows.npy
*/windows.npy
**/windows.npy

# Raw downloads (300+ MB zips, 800+ unzipped record files)
**/training/
*.zip
*.tar.gz

# Verbose per-run logs at logs/ root; the curated audit trail under
# logs/audit_trail/ is committed.
logs/curl_phys2015.log
logs/preprocess_physionet.log
logs/data_loaders_verify.log
logs/wget_phys2015.log

# Per-run raw LLM traces (100s of MB each) — keep on disk for auditing but don't ship
results/runs/*/raw_trace.jsonl


# Serena MCP plugin local project state (IDE tool, not project artefact)
.serena/

# Internal review notes (organizational QC; not for external sharing)
review/

# OpenReview reviewer comments + rebuttal drafts (sensitive: keep local only,
# used as reference for camera-ready edits but not for public release)
openreview/

# demo/ removed at user request (was empty scaffold)
demo/

# Dev-only sync/scrub helper scripts (not for publication repo)
.sync_intermediates*.sh
.scrub_trace_timestamps.py


# LLM-call cache produced by experiments/analysis/prefill_llm_cache.py
# (regenerable from results/runs/seed*/raw_trace.jsonl.gz; not source)
results/runs/llm_cache.jsonl.gz
